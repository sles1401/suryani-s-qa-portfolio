{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/projects",
        "http://localhost:4173/projects/orangehrm-manual-testing",
        "http://localhost:4173/resume",
        "http://localhost:4173/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "canonical",
          "is-crawlable"
        ],
        "chromeFlags": [
          "--force-dark-mode",
          "--enable-features=WebContentsForceDark"
        ]
      },
      "startServerCommand": "bunx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local:"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 1600000
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-dark"
    }
  }
}